{
  "expo": {
    "name": "TrustPhone",
    "slug": "TrustPhone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ChatGPT Image 10 sept 2026, 01_53_23 p.m..png",
    "scheme": "trustphone",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.TrustPhone"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ChatGPT Image 10 sept 2026, 01_53_23 p.m..png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./assets/images/ChatGPT Image 10 sept 2026, 01_53_23 p.m..png",
            "imageWidth": 300,
            "resizeMode": "contain",
            "backgroundColor": "#1A202C"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}